{% block main_css %}
    {# home: the first screen is styled by the inline CSS above, the full sheets load without blocking the first paint #}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'ishara.css' | asset }}" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="{{ 'app.css' | asset }}"><link rel="stylesheet" href="{{ 'ishara.css' | asset }}"></noscript>
{% endblock %}
{% block content %}
    {# Ishara: the first banner slide is plain HTML so it shows before any script runs (ishara.js adds the other slides) #}
    <section class="ish ish-sec ish-hero" id="ish-hero-ph"><div class="ish-wrap"><div class="ish-slider"><div class="ish-slide ish-photo on"><div class="ish-slide__txt"><span class="ish-pill">وصل حديثاً</span><h2>تشكيلة الموسم الجديدة</h2><p>قطع مختارة بعناية، وتوصيل سريع لكل مدن المملكة.</p><a class="ish-btn ish-btn--light" href="{{ store.url }}">تسوّق الآن</a></div></div></div></div></section>
    {% component home %}
{% endblock %}
{% block scripts %}
    <script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}